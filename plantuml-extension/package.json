{
  "name": "plantuml-editor",
  "displayName": "PlantUML Editor",
  "description": "PlantUML Interactive Editor",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.113.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "plantuml-interactive-editor.openDiagram",
        "title": "PlantUML: Open Interactive Diagram"
      }
    ],
    "configuration": {
      "title": "PlantUML Interactive Editor",
      "properties": {
        "plantumlInteractive.pythonPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "order": 1,
          "markdownDescription": "Absolute path to a Python interpreter that has the `plantuml-gui` package installed. Required: that package is the rendering backend. When empty, the `PLANTUML_GUI_PYTHON` environment variable is used."
        },
        "plantumlInteractive.plantumlJar": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "order": 2,
          "markdownDescription": "Absolute path to `plantuml.jar`, used to render diagrams. When empty, the `PLANTUML_JAR` environment variable is used, then the shared internal install if this machine has it."
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "dependencies": {
    "bootstrap": "4.6.2",
    "diff": "8.0.3",
    "jquery": "3.7.1",
    "panzoom": "9.4.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "globals": "^16.5.0"
  },
  "overrides": {
    "diff": "8.0.3",
    "serialize-javascript": "^7.0.6"
  }
}
