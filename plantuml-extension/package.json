{
  "name": "plantuml-editor",
  "displayName": "PlantUML Editor",
  "description": "PlantUML Interactive Editor",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "plantuml-interactive-editor.openDiagram",
        "title": "PlantUML: Open Interactive Diagram"
      }
    ],
    "configuration": {
      "title": "PlantUML Interactive Editor",
      "properties": {
        "plantumlInteractive.plantumlJar": {
          "type": "string",
          "default": "",
          "description": "Absolute path to plantuml.jar, used to render diagrams. Falls back to the PLANTUML_JAR environment variable, and then to a known shared install path (if present on disk), if not set."
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "globals": "^16.5.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
